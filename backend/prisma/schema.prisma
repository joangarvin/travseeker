datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Destino {
  id                    String      @id @default(uuid())
  nombre                String
  tipoTurismoPrincipal  String
  tipoTurismoSecundario String
  presupuesto           String
  masificacion          String
  mesesJulioAgosto      Int
  mesesNovAbril         Int
  mesesMayJunSeptOct    Int
  destinosItem          String?
  ubicacion             String
  descripcion           String
  imprescindibles       String
  imagen                String
  latitud               Float?
  longitud              Float?
  updatedAt             DateTime    @updatedAt

  municipioLinks        DestinoMunicipio[]
  favoritos             Favorito[]
  reviews               Review[]
  collectionItems       CollectionItem[]
}

model Municipio {
  id              String  @id @default(uuid())
  nombre          String
  precios         String
  conexiones      String
  tipoTurismo     String?

  destinoLinks    DestinoMunicipio[]
}

model DestinoMunicipio {
  destinoId   String
  municipioId String

  destino     Destino   @relation(fields: [destinoId], references: [id], onDelete: Cascade)
  municipio   Municipio @relation(fields: [municipioId], references: [id], onDelete: Cascade)

  @@id([destinoId, municipioId])
  @@index([municipioId])
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String
  nombre        String?
  apellidos     String?
  avatarUrl     String?
  bio           String?
  role          String    @default("user")
  locale        String    @default("es")
  preferences   Json?
  metadata      Json?
  isActive      Boolean   @default(true)
  emailVerified Boolean   @default(false)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  favoritos     Favorito[]
  reviews       Review[]
  tokens        VerificationToken[]
  collections   Collection[]
  alerts        AlertSubscription[]
  collectionMemberships CollectionMember[]
}

model AlertSubscription {
  id            String   @id @default(uuid())
  userId        String
  month         Int?
  tipos         Json?
  presupuesto   String?
  avoidCrowds   Boolean  @default(true)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lastCheckedAt DateTime?
  lastNotifiedAt DateTime?

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries    AlertDelivery[]

  @@index([userId, isActive])
}

model AlertDelivery {
  id        String   @id @default(uuid())
  alertId   String
  fingerprint String
  status    String   @default("pending")
  error     String?
  sentAt    DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  alert AlertSubscription @relation(fields: [alertId], references: [id], onDelete: Cascade)

  @@unique([alertId, fingerprint])
  @@index([status, createdAt])
}

model Collection {
  id          String   @id @default(uuid())
  userId      String
  nombre      String
  descripcion String?
  color       String   @default("emerald")
  visibility  String   @default("private")
  shareToken  String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       CollectionItem[]
  members     CollectionMember[]

  @@index([userId])
}

model CollectionMember {
  id           String         @id @default(uuid())
  collectionId String
  userId       String
  role         CollectionRole @default(viewer)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([collectionId, userId])
  @@index([userId])
}

enum CollectionRole {
  editor
  viewer
}

model CollectionItem {
  id           String   @id @default(uuid())
  collectionId String
  destinoId    String
  notas        String?
  createdAt    DateTime @default(now())

  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  destino      Destino    @relation(fields: [destinoId], references: [id], onDelete: Cascade)

  @@unique([collectionId, destinoId])
  @@index([collectionId])
  @@index([destinoId])
}

model Review {
  id           String       @id @default(uuid())
  userId       String
  destinoId    String
  rating       Int
  comment      String?
  visitMonth   Int?
  travelParty  String?
  crowdRating  Int?
  valueRating  Int?
  accessRating Int?
  status       ReviewStatus @default(published)
  adminResponse String?
  respondedAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  destino   Destino  @relation(fields: [destinoId], references: [id], onDelete: Cascade)

  @@unique([userId, destinoId])
  @@index([destinoId])
}

enum ReviewStatus {
  published
  hidden
}

model VerificationToken {
  id        String   @id @default(uuid())
  userId    String
  type      String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Favorito {
  id        String   @id @default(uuid())
  userId    String
  destinoId String
  notas     String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  destino   Destino  @relation(fields: [destinoId], references: [id], onDelete: Cascade)

  @@unique([userId, destinoId])
  @@index([userId])
  @@index([destinoId])
}
