datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Destino {
  translations Json @default("{}")
  id                    String          @id @default(uuid())
  nombre                String
  tipoTurismoPrincipal  String
  tipoTurismoSecundario String
  presupuesto           String
  masificacion          String
  mesesJulioAgosto      Int
  mesesNovAbril         Int
  mesesMayJunSeptOct    Int
  destinosItem          String?
  ubicacion             String
  descripcion           String
  imprescindibles       String
  imagen                String
  latitud               Float?
  longitud              Float?
  updatedAt             DateTime        @updatedAt
  editorialStatus       EditorialStatus @default(pending)
  submittedAt           DateTime        @default(now())
  reviewedAt            DateTime?
  createdById           String?
  reviewedById          String?

  municipioLinks   DestinoMunicipio[]
  favoritos        Favorito[]
  reviews          Review[]
  collectionItems  CollectionItem[]
  places           Place[]
  essentialGroups  EssentialGroup[]
  activityLinks    DestinoActivity[]
  tourismTypeLinks DestinoTourismType[]
  climateCache     ClimateCache?
  createdBy        User?                @relation("DestinoCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  reviewedBy       User?                @relation("DestinoReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([editorialStatus, updatedAt])
  @@index([createdById])
  @@index([reviewedById])
}

model ClimateCache {
  id                    String   @id @default(uuid())
  destinationId         String   @unique
  coordinateFingerprint String
  provider              String
  model                 String
  periodStart           DateTime @db.Date
  periodEnd             DateTime @db.Date
  monthlySummary        Json
  fetchedAt             DateTime
  expiresAt             DateTime
  updatedAt             DateTime @updatedAt

  destination Destino @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model Activity {
  translations Json @default("{}")
  id              String          @id @default(uuid())
  name            String          @unique
  slug            String          @unique
  icon            String          @default("Compass")
  sortOrder       Int             @default(0)
  isActive        Boolean         @default(false)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  editorialStatus EditorialStatus @default(pending)
  submittedAt     DateTime        @default(now())
  reviewedAt      DateTime?
  createdById     String?
  reviewedById    String?

  destinationLinks DestinoActivity[]
  createdBy        User?             @relation("ActivityCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  reviewedBy       User?             @relation("ActivityReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([isActive, sortOrder, name])
  @@index([editorialStatus, sortOrder, name])
  @@index([createdById])
  @@index([reviewedById])
}

model DestinoActivity {
  destinoId  String
  activityId String

  destino  Destino  @relation(fields: [destinoId], references: [id], onDelete: Cascade)
  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@id([destinoId, activityId])
  @@index([activityId])
}

model TourismType {
  translations Json @default("{}")
  id              String          @id @default(uuid())
  name            String          @unique
  slug            String          @unique
  description     String          @default("")
  icon            String          @default("Compass")
  colorKey        String          @default("otro")
  colorValue      String          @default("#5f6470")
  sortOrder       Int             @default(0)
  isActive        Boolean         @default(false)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  editorialStatus EditorialStatus @default(pending)
  submittedAt     DateTime        @default(now())
  reviewedAt      DateTime?
  createdById     String?
  reviewedById    String?

  destinationLinks DestinoTourismType[]
  createdBy        User?                @relation("TourismTypeCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  reviewedBy       User?                @relation("TourismTypeReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([isActive, sortOrder, name])
  @@index([editorialStatus, sortOrder, name])
  @@index([createdById])
  @@index([reviewedById])
}

model DestinoTourismType {
  destinoId     String
  tourismTypeId String

  destino     Destino     @relation(fields: [destinoId], references: [id], onDelete: Cascade)
  tourismType TourismType @relation(fields: [tourismTypeId], references: [id], onDelete: Cascade)

  @@id([destinoId, tourismTypeId])
  @@index([tourismTypeId])
}

model Place {
  translations Json @default("{}")
  id              String          @id @default(uuid())
  destinoId       String
  nombre          String
  categoria       String
  descripcion     String?
  latitud         Float
  longitud        Float
  website         String?
  sortOrder       Int             @default(0)
  isActive        Boolean         @default(false)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  editorialStatus EditorialStatus @default(pending)
  submittedAt     DateTime        @default(now())
  reviewedAt      DateTime?
  createdById     String?
  reviewedById    String?

  destino        Destino         @relation(fields: [destinoId], references: [id], onDelete: Cascade)
  essentialItems EssentialItem[]
  createdBy      User?           @relation("PlaceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  reviewedBy     User?           @relation("PlaceReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([destinoId, isActive, sortOrder])
  @@index([editorialStatus, destinoId, sortOrder])
  @@index([createdById])
  @@index([reviewedById])
}

model EssentialGroup {
  translations Json @default("{}")
  id        String   @id @default(uuid())
  destinoId String
  title     String
  icon      String   @default("Compass")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  destino Destino         @relation(fields: [destinoId], references: [id], onDelete: Cascade)
  items   EssentialItem[]

  @@index([destinoId, sortOrder])
}

model EssentialItem {
  catalogActivityId String?
  catalogActivity Experience? @relation("FeaturedActivity", fields: [catalogActivityId], references: [id], onDelete: SetNull)
  @@index([catalogActivityId])
  municipalityExperience Experience?
  translations Json @default("{}")
  id                  String   @id @default(uuid())
  groupId             String
  placeId             String?
  title               String
  description         String?
  icon                String?
  imageUrl            String?
  imageAlt            String?
  duration            String?
  bestTime            String?
  reservationRequired Boolean?
  officialUrl         String?
  sortOrder           Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  group EssentialGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  place Place?         @relation(fields: [placeId], references: [id], onDelete: SetNull)

  @@index([groupId, sortOrder])
  @@index([placeId])
}

model Municipio {
  translations Json @default("{}")
  id              String          @id @default(uuid())
  nombre          String
  precios         String
  conexiones      String
  tipoTurismo     String?
  latitud         Float?
  longitud        Float?
  editorialStatus EditorialStatus @default(pending)
  submittedAt     DateTime        @default(now())
  reviewedAt      DateTime?
  createdById     String?
  reviewedById    String?

  descripcion String @default("")
  imagen String @default("")
  imagenAlt String @default("")
  ubicacion String @default("")
  website String @default("")
  mejorEpoca String @default("")
  consejos String @default("")
  activityLinks MunicipioExperience[]
  hotelLinks MunicipioHotel[]
  restaurantLinks MunicipioRestaurant[]
  destinoLinks DestinoMunicipio[]
  createdBy    User?              @relation("MunicipioCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  reviewedBy   User?              @relation("MunicipioReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([editorialStatus, nombre])
  @@index([createdById])
  @@index([reviewedById])
}

model DestinoMunicipio {
  destinoId   String
  municipioId String

  destino   Destino   @relation(fields: [destinoId], references: [id], onDelete: Cascade)
  municipio Municipio @relation(fields: [municipioId], references: [id], onDelete: Cascade)

  @@id([destinoId, municipioId])
  @@index([municipioId])
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String
  nombre        String?
  apellidos     String?
  avatarUrl     String?
  bio           String?
  role          String    @default("user")
  locale        String    @default("es")
  preferences   Json?
  metadata      Json?
  isActive      Boolean   @default(true)
  emailVerified Boolean   @default(false)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  favoritos             Favorito[]
  reviews               Review[]
  tokens                VerificationToken[]
  collections           Collection[]
  alerts                AlertSubscription[]
  collectionMemberships CollectionMember[]
  destinosCreated       Destino[]           @relation("DestinoCreatedBy")
  destinosReviewed      Destino[]           @relation("DestinoReviewedBy")
  activitiesCreated     Activity[]          @relation("ActivityCreatedBy")
  activitiesReviewed    Activity[]          @relation("ActivityReviewedBy")
  tourismTypesCreated   TourismType[]       @relation("TourismTypeCreatedBy")
  tourismTypesReviewed  TourismType[]       @relation("TourismTypeReviewedBy")
  municipiosCreated     Municipio[]         @relation("MunicipioCreatedBy")
  municipiosReviewed    Municipio[]         @relation("MunicipioReviewedBy")
  placesCreated         Place[]             @relation("PlaceCreatedBy")
  placesReviewed        Place[]             @relation("PlaceReviewedBy")
}

enum EditorialStatus {
  draft
  pending
  published
  archived
}

model AlertSubscription {
  id             String    @id @default(uuid())
  userId         String
  month          Int?
  tipos          Json?
  presupuesto    String?
  avoidCrowds    Boolean   @default(true)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  lastCheckedAt  DateTime?
  lastNotifiedAt DateTime?

  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries AlertDelivery[]

  @@index([userId, isActive])
}

model AlertDelivery {
  id          String    @id @default(uuid())
  alertId     String
  fingerprint String
  status      String    @default("pending")
  error       String?
  sentAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  alert AlertSubscription @relation(fields: [alertId], references: [id], onDelete: Cascade)

  @@unique([alertId, fingerprint])
  @@index([status, createdAt])
}

model Collection {
  id            String    @id @default(uuid())
  userId        String
  nombre        String
  descripcion   String?
  color         String    @default("emerald")
  visibility    String    @default("private")
  shareToken    String?   @unique
  startDate     DateTime? @db.Date
  endDate       DateTime? @db.Date
  travelerCount Int       @default(2)
  itinerary     Json      @default("[]")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  items   CollectionItem[]
  members CollectionMember[]

  @@index([userId])
}

model CollectionMember {
  id           String         @id @default(uuid())
  collectionId String
  userId       String
  role         CollectionRole @default(viewer)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([collectionId, userId])
  @@index([userId])
}

enum CollectionRole {
  editor
  viewer
}

model CollectionItem {
  id           String   @id @default(uuid())
  collectionId String
  destinoId    String
  notas        String?
  dayIndex     Int?
  status       String   @default("idea")
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  destino    Destino    @relation(fields: [destinoId], references: [id], onDelete: Cascade)

  @@unique([collectionId, destinoId])
  @@index([collectionId])
  @@index([destinoId])
}

model Review {
  id            String       @id @default(uuid())
  userId        String
  destinoId     String
  rating        Int
  comment       String?
  visitMonth    Int?
  travelParty   String?
  crowdRating   Int?
  valueRating   Int?
  accessRating  Int?
  status        ReviewStatus @default(pending)
  adminResponse String?
  respondedAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  destino Destino @relation(fields: [destinoId], references: [id], onDelete: Cascade)

  @@unique([userId, destinoId])
  @@index([destinoId])
}

enum ReviewStatus {
  pending
  published
  rejected
  flagged
}

model VerificationToken {
  id        String    @id @default(uuid())
  userId    String
  type      String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Favorito {
  id        String   @id @default(uuid())
  userId    String
  destinoId String
  notas     String?
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  destino Destino @relation(fields: [destinoId], references: [id], onDelete: Cascade)

  @@unique([userId, destinoId])
  @@index([userId])
  @@index([destinoId])
}

model Experience {
  translations Json @default("{}")
  featuredItems EssentialItem[] @relation("FeaturedActivity")
  essentialItemId String? @unique
  essentialItem EssentialItem? @relation(fields: [essentialItemId], references: [id], onDelete: SetNull)
  id String @id @default(uuid())
  nombre String @default("")
  descripcion String @default("")
  imagen String @default("")
  imagenAlt String @default("")
  address String @default("")
  website String @default("")
  bookingUrl String @default("")
  phone String @default("")
  price String @default("")
  duration String @default("")
  bestTime String @default("")
  category String @default("")
  latitud Float?
  longitud Float?
  isPublished Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  municipioLinks MunicipioExperience[]
  @@index([isPublished, nombre])
}

model MunicipioExperience {
  municipioId String
  recordId String
  sortOrder Int @default(0)
  municipio Municipio @relation(fields: [municipioId], references: [id], onDelete: Cascade)
  record Experience @relation(fields: [recordId], references: [id], onDelete: Cascade)
  @@id([municipioId, recordId])
  @@index([recordId])
}

model Hotel {
  id String @id @default(uuid())
  nombre String @default("")
  descripcion String @default("")
  imagen String @default("")
  imagenAlt String @default("")
  address String @default("")
  website String @default("")
  bookingUrl String @default("")
  phone String @default("")
  price String @default("")
  stars String @default("")
  amenities String @default("")
  latitud Float?
  longitud Float?
  isPublished Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  municipioLinks MunicipioHotel[]
  @@index([isPublished, nombre])
}

model MunicipioHotel {
  municipioId String
  recordId String
  sortOrder Int @default(0)
  municipio Municipio @relation(fields: [municipioId], references: [id], onDelete: Cascade)
  record Hotel @relation(fields: [recordId], references: [id], onDelete: Cascade)
  @@id([municipioId, recordId])
  @@index([recordId])
}

model Restaurant {
  id String @id @default(uuid())
  nombre String @default("")
  descripcion String @default("")
  imagen String @default("")
  imagenAlt String @default("")
  address String @default("")
  website String @default("")
  bookingUrl String @default("")
  phone String @default("")
  price String @default("")
  cuisine String @default("")
  openingHours String @default("")
  latitud Float?
  longitud Float?
  isPublished Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  municipioLinks MunicipioRestaurant[]
  @@index([isPublished, nombre])
}

model MunicipioRestaurant {
  municipioId String
  recordId String
  sortOrder Int @default(0)
  municipio Municipio @relation(fields: [municipioId], references: [id], onDelete: Cascade)
  record Restaurant @relation(fields: [recordId], references: [id], onDelete: Cascade)
  @@id([municipioId, recordId])
  @@index([recordId])
}
